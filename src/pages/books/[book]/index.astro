---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { books } from '../../../books';
import { getBookChapters, chapterNumber, chapterTitle, chapterSlug } from '../../../lib/chapters';
import { counts, exerciseChapterSlug, getBookExercises } from '../../../lib/exercises';
import { href } from '../../../lib/url';

export async function getStaticPaths() {
  return books.map((book) => ({ params: { book: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const chapters = await getBookChapters(book.slug);

const sets = await getBookExercises(book.slug);
const exerciseCounts = new Map(sets.map((ex) => [exerciseChapterSlug(ex), counts(ex).total]));
const exerciseTotal = sets.reduce((a, ex) => a + counts(ex).total, 0);
---

<BaseLayout title={`${book.title} — Library of Quant`} description={book.description}>
  <div class="container">
    <div class="book-head">
      <span class="eyebrow">{book.badge} &nbsp;·&nbsp; {chapters.length} chapters</span>
      <h1>{book.title}</h1>
      <p>{book.description}</p>
      {
        exerciseTotal > 0 && (
          <p class="quiz-index-links">
            <a href={href(`/books/${book.slug}/exercises/`)}>
              {exerciseTotal} exercises across {sets.length} chapters →
            </a>
          </p>
        )
      }
    </div>

    <ol class="toc">
      {
        chapters.map((ch) => (
          <li>
            <a href={href(`/books/${book.slug}/${chapterSlug(ch)}/`)}>
              <span class="num">{String(chapterNumber(ch)).padStart(2, '0')}</span>
              <span class="ch-title">{chapterTitle(ch)}</span>
              {exerciseCounts.get(chapterSlug(ch)) && (
                <span class="toc-ex">{exerciseCounts.get(chapterSlug(ch))} ex</span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
