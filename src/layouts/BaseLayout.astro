---
import '../styles/global.css';
import { href } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'A library of technical books for quants and systems engineers.' } =
  Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%9A%3C/text%3E%3C/svg%3E" />
    <!-- Set theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href={href('/')} class="brand">
        <span><span class="brand-mark">Library</span> of Quant</span>
        <span class="brand-sub">books for systems engineers</span>
      </a>
      <div class="header-actions">
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle color theme"
          title="Toggle light/dark"
        >
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Library of Quant — built with Astro. © {new Date().getFullYear()}</p>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        const next = el.dataset.theme === 'dark' ? 'light' : 'dark';
        el.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
